<view class="page data-v-ac5467f4"><view class="section-title data-v-ac5467f4">推送消息</view><block wx:for="{{$root.l0}}" wx:for-item="m" wx:for-index="i"><view class="card data-v-ac5467f4"><view class="top data-v-ac5467f4"><text class="name data-v-ac5467f4">{{m.$orig.title}}</text><text class="time data-v-ac5467f4">{{m.m0}}</text></view><view class="info data-v-ac5467f4">{{m.$orig.content}}</view><block wx:if="{{m.$orig.msgType}}"><view class="tag data-v-ac5467f4">{{"类型："+m.$orig.msgType}}</view></block></view></block><block wx:if="{{$root.g0===0}}"><view class="empty data-v-ac5467f4">暂无推送消息</view></block><view class="section-title data-v-ac5467f4">预警与设备概览</view><block wx:for="{{rules}}" wx:for-item="r" wx:for-index="i"><view class="card data-v-ac5467f4"><view class="top data-v-ac5467f4"><text class="name data-v-ac5467f4">{{r.ruleName}}</text><text class="{{['tag','data-v-ac5467f4',r.status===1?'on':'off']}}">{{''+(r.status===1?'启用':'停用')+''}}</text></view><view class="info data-v-ac5467f4">{{"设备类型："+r.deviceType+"　等级："+r.alarmLevel}}</view><block wx:if="{{r.alarmCondition}}"><view class="info data-v-ac5467f4">{{"条件："+r.alarmCondition+" "+(r.threshold||'')}}</view></block></view></block><block wx:for="{{devices}}" wx:for-item="d" wx:for-index="i"><view class="card data-v-ac5467f4"><view class="top data-v-ac5467f4"><text class="name data-v-ac5467f4">{{d.deviceName}}</text><text class="{{['tag','data-v-ac5467f4',d.status===1?'on':'off']}}">{{''+(d.status===1?'在线':'离线')+''}}</text></view><view class="info data-v-ac5467f4">{{"类型："+d.deviceType+"　位置："+(d.location||'—')}}</view></view></block><block wx:if="{{$root.g1}}"><view class="empty data-v-ac5467f4">暂无预警与设备信息</view></block></view>