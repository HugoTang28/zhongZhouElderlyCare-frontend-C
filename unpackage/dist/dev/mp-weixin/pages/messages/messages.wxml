<view class="page data-v-ac5467f4"><view class="header data-v-ac5467f4"><view class="header-title data-v-ac5467f4">消息与预警</view><view class="header-sub data-v-ac5467f4">院内通知、护理提醒与设备预警</view></view><view class="content data-v-ac5467f4"><block wx:if="{{loading}}"><view class="state-box data-v-ac5467f4"><view class="spinner data-v-ac5467f4"></view><text class="state-text data-v-ac5467f4">正在加载消息...</text></view></block><block wx:else><view class="data-v-ac5467f4"><view class="section data-v-ac5467f4"><view class="section-title data-v-ac5467f4"><text class="dot blue data-v-ac5467f4"></text><text class="data-v-ac5467f4">最新通知</text></view><block wx:if="{{$root.g0===0}}"><view class="empty-mini data-v-ac5467f4">暂无消息</view></block><block wx:else><view class="msg-list data-v-ac5467f4"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index"><view class="msg-item data-v-ac5467f4"><view class="{{item.m0}}">{{item.m1}}</view><view class="msg-body data-v-ac5467f4"><view class="msg-title data-v-ac5467f4">{{item.$orig.title}}</view><view class="msg-content data-v-ac5467f4">{{item.$orig.content}}</view><view class="msg-time data-v-ac5467f4">{{item.$orig.pushTime}}</view></view></view></block></view></block></view><view class="section data-v-ac5467f4"><view class="section-title data-v-ac5467f4"><text class="dot red data-v-ac5467f4"></text><text class="data-v-ac5467f4">预警规则</text></view><block wx:if="{{$root.g1===0}}"><view class="empty-mini data-v-ac5467f4">暂无预警规则</view></block><block wx:else><block wx:for="{{alarmRules}}" wx:for-item="item" wx:for-index="index"><view class="card data-v-ac5467f4"><view class="card-top data-v-ac5467f4"><view class="card-title data-v-ac5467f4">{{item.ruleName}}</view><view class="tag red data-v-ac5467f4">预警中</view></view><view class="card-body data-v-ac5467f4"><view class="row data-v-ac5467f4"><text class="label data-v-ac5467f4">设备类型</text><text class="value data-v-ac5467f4">{{item.deviceType}}</text></view><view class="row data-v-ac5467f4">