<view class="page data-v-552bca60"><view class="header data-v-552bca60"><view class="header-title data-v-552bca60">账单与预存</view><view class="header-sub data-v-552bca60">费用明细与账户余额实时查看</view></view><view class="content data-v-552bca60"><view class="balance-card data-v-552bca60"><view class="balance-label data-v-552bca60">当前账户余额</view><view class="balance-value data-v-552bca60">{{"¥"+balance}}</view><view class="balance-tip data-v-552bca60">预存金可用于抵扣月度账单</view></view><block wx:if="{{loading}}"><view class="state-box data-v-552bca60"><view class="spinner data-v-552bca60"></view><text class="state-text data-v-552bca60">正在加载账单...</text></view></block><block wx:else><view class="data-v-552bca60"><view class="section data-v-552bca60"><view class="section-title data-v-552bca60"><text class="dot red data-v-552bca60"></text><text class="data-v-552bca60">待缴 / 已缴账单</text></view><block wx:if="{{$root.g0===0}}"><view class="empty-mini data-v-552bca60">暂无账单</view></block><block wx:else><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index"><view class="card data-v-552bca60"><view class="card-top data-v-552bca60"><view class="card-title data-v-552bca60">{{item.$orig.billType}}</view><view class="{{item.m0}}">{{"¥"+item.$orig.amount}}</view></view><view class="card-body data-v-552bca60"><view class="row data-v-552bca60"><text class="label data-v-552bca60">老人</text><text class="value data-v-552bca60">{{item.$orig.elderName}}</text></view><view class="row data-v-552bca60"><text class="label data-v-552bca60">状态</text><text class="{{item.m1}}">{{item.m2}}</text></view><view class="row data-v-552bca60"><text class="label data-v-552bca60">账单时间</text><text class="value data-v-552bca60">{{item.$orig.billMonth||item.$orig.createTime}}</text></view></view></view></block></block></view><view class="section data-v-552bca60"><view class="section-title data-v-552bca60"><text class="dot blue data-v-552bca60"></text><text class="data-v-552bca60">预存流水</text></view><block wx:if="{{$root.g1===0}}"><view class="empty-mini data-v-552bca60">暂无预存记录</view></block><block wx:else><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index"><view class="flow-item data-v-552bca60"><view class="flow-left data-v-552bca60"><view class="flow-title data-v-552bca60">{{item.m3}}</view><view class="flow-time data-v-552bca60">{{item.$orig.transactionTime||item.$orig.createTime}}</view></view><view class="flow-right data-v-552bca60"><view class="{{['flow-amount','data-v-552bca60',item.$orig.amount>=0?'in':'out']}}">{{(item.$orig.amount>=0?'+':'')+item.$orig.amount}}</view><view class="flow-balance data-v-552bca60">{{"余额 ¥"+item.$orig.balance}}</view></view></view></block></block></view></view></block></view></view>