<view class="page data-v-d862bdee"><view class="header data-v-d862bdee"><view class="header-title data-v-d862bdee">账单与预存</view><view class="header-sub data-v-d862bdee">费用明细与账户余额实时查看</view></view><view class="content data-v-d862bdee"><view class="balance-card data-v-d862bdee"><view class="balance-label data-v-d862bdee">当前账户余额</view><view class="balance-value data-v-d862bdee">¥{{a}}</view><view class="balance-tip data-v-d862bdee">预存金可用于抵扣月度账单</view></view><view wx:if="{{b}}" class="state-box data-v-d862bdee"><view class="spinner data-v-d862bdee"></view><text class="state-text data-v-d862bdee">正在加载账单...</text></view><view wx:else class="data-v-d862bdee"><view class="section data-v-d862bdee"><view class="section-title data-v-d862bdee"><text class="dot red data-v-d862bdee"></text><text class="data-v-d862bdee">待缴 / 已缴账单</text></view><view wx:if="{{c}}" class="empty-mini data-v-d862bdee">暂无账单</view><block wx:else><view wx:for="{{d}}" wx:for-item="item" wx:key="h" class="card data-v-d862bdee"><view class="card-top data-v-d862bdee"><view class="card-title data-v-d862bdee">{{item.a}}</view><view class="{{['amount', 'data-v-d862bdee', item.c]}}">¥{{item.b}}</view></view><view class="card-body data-v-d862bdee"><view class="row data-v-d862bdee"><text class="label data-v-d862bdee">老人</text><text class="value data-v-d862bdee">{{item.d}}</text></view><view class="row data-v-d862bdee"><text class="label data-v-d862bdee">状态</text><text class="{{['value', 'data-v-d862bdee', item.f]}}">{{item.e}}</text></view><view class="row data-v-d862bdee"><text class="label data-v-d862bdee">账单周期</text><text class="value data-v-d862bdee">{{item.g}}</text></view></view></view></block></view><view class="section data-v-d862bdee"><view class="section-title data-v-d862bdee"><text class="dot blue data-v-d862bdee"></text><text class="data-v-d862bdee">预存流水</text></view><view wx:if="{{e}}" class="empty-mini data-v-d862bdee">暂无预存记录</view><block wx:else><view wx:for="{{f}}" wx:for-item="item" wx:key="f" class="flow-item data-v-d862bdee"><view class="flow-left data-v-d862bdee"><view class="flow-title data-v-d862bdee">{{item.a}}</view><view class="flow-time data-v-d862bdee">{{item.b}}</view></view><view class="flow-right data-v-d862bdee"><view class="{{['flow-amount', 'data-v-d862bdee', item.d]}}">{{item.c}}</view><view class="flow-balance data-v-d862bdee">余额 ¥{{item.e}}</view></view></view></block></view></view></view></view>