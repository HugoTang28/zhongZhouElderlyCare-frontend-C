page{--brand: #3b7cff;--brand-2: #5e9bff;--brand-soft: #eaf1ff;--success: #07c160;--warning: #ff9900;--danger: #ff4d4f;--danger-soft: #ffebeb;--text-1: #1a1a1a;--text-2: #333333;--text-3: #666666;--text-4: #999999;--line: #f0f2f5;--bg: #f5f7fa;--radius-lg: 28rpx;--radius-md: 20rpx;--radius-sm: 14rpx;--shadow-card: 0 8rpx 30rpx rgba(20, 38, 80, .07);--shadow-brand: 0 12rpx 30rpx rgba(59, 124, 255, .28);background-color:var(--bg);font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,Helvetica,PingFang SC,Microsoft YaHei,sans-serif;color:var(--text-2);-webkit-font-smoothing:antialiased}view,text,input,button{box-sizing:border-box}.zz-spinner{width:56rpx;height:56rpx;border:5rpx solid #e6ebf5;border-top-color:var(--brand);border-radius:50%;margin:0 auto 20rpx;animation:zz-spin .9s linear infinite}@keyframes zz-spin{to{transform:rotate(360deg)}}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}