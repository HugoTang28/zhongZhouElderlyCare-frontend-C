  flex: 1;
  min-width: 0;
}
.card-arrow.data-v-18f9d8a6 {
  color: #c5ccd6;
  font-size: 44rpx;
  line-height: 1;
  margin-left: 12rpx;
}
.name-line.data-v-18f9d8a6 {
  display: flex;
  align-items: center;
}
.name.data-v-18f9d8a6 {
