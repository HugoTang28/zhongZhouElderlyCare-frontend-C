/* uni-app 全局样式变量 */
.summary.data-v-18f9d8a6 {
  font-size: 26rpx;
  color: #666;
  margin: 24rpx 8rpx 8rpx;
}
.elder-card.data-v-18f9d8a6 {
  background: #fff;
