<view class="page data-v-18f9d8a6"><view class="header data-v-18f9d8a6"><view class="header-title data-v-18f9d8a6">我的家人</view><view class="header-sub data-v-18f9d8a6">随时关注长者在院情况</view></view><view class="content data-v-18f9d8a6"><view wx:if="{{a}}" class="state-box data-v-18f9d8a6"><view class="spinner data-v-18f9d8a6"></view><text class="state-text data-v-18f9d8a6">正在加载家人信息...</text></view><view wx:elif="{{b}}" class="state-box data-v-18f9d8a6"><view class="empty-icon data-v-18f9d8a6">👨‍⚕️</view><text class="state-text data-v-18f9d8a6">暂无关联老人</text><text class="state-tip data-v-18f9d8a6">请联系养老院工作人员绑定家属手机号</text></view><view wx:else class="data-v-18f9d8a6"><view class="summary data-v-18f9d8a6">共 {{c}} 位在院亲人</view><view wx:for="{{d}}" wx:for-item="item" wx:key="m" class="elder-card data-v-18f9d8a6"><view class="card-head data-v-18f9d8a6"><view class="avatar data-v-18f9d8a6">{{item.a}}</view><view class="head-info data-v-18f9d8a6"><view class="name-line data-v-18f9d8a6"><text class="name data-v-18f9d8a6">{{item.b}}</text><text class="{{['badge', 'data-v-18f9d8a6', item.d]}}">{{item.c}}</text></view><view class="meta data-v-18f9d8a6">{{item.e}} · {{item.f}}岁</view></view></view><view class="info-grid data-v-18f9d8a6"><view class="info-item data-v-18f9d8a6"><text class="info-label data-v-18f9d8a6">身份证号</text><text class="info-value data-v-18f9d8a6">{{item.g}}</text></view><view class="info-item data-v-18f9d8a6"><text class="info-label data-v-18f9d8a6">床位号</text><text class="info-value data-v-18f9d8a6">{{item.h}}</text></view><view class="info-item data-v-18f9d8a6"><text class="info-label data-v-18f9d8a6">合同编号</text><text class="info-value data-v-18f9d8a6">{{item.i}}</text></view><view class="info-item data-v-18f9d8a6"><text class="info-label data-v-18f9d8a6">家属联系人</text><text class="info-value data-v-18f9d8a6">{{item.j}}</text></view><view class="info-item data-v-18f9d8a6"><text class="info-label data-v-18f9d8a6">联系电话</text><text class="info-value data-v-18f9d8a6">{{ite