  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(160deg, #eaf1ff 0%, #f5f7fa 46%, #f5f7fa 100%);
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
}
.login .deco.data-v-cdfe2409 {
  position: absolute;
