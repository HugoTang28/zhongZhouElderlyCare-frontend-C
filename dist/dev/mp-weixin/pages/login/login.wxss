/* 品牌区 */
.brand.data-v-cdfe2409 {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-top: 170rpx;
  margin-bottom: 70rpx;
}
.brand-logo.data-v-cdfe2409 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 38rpx;
  margin: 0 auto 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(59, 124, 255, 0.35);
}
.brand-name.data-v-cdfe2409 {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}
.brand-sub.data-v-cdfe2409 {
  font-size: 26rpx;
  color: #8a9099;
  margin-top: 16rpx;
}
.form-card.data-v-cdfe2409 {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 44rpx;
  box-shadow: 0 20rpx 60rpx rgba(31, 52, 110, 0.12);
}
.form-card.data-v-cdfe2409 .up-form-item__body {
  padding: 0 0 28rpx 0 !important;
}
.form-card .dev-tip.data-v-cdfe2409 {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fff8ec;
  border: 2rpx dashed #ffd591;
  border-radius: 16rpx;
}
.form-card .dev-tip-row.data-v-cdfe2409 {
  display: flex;
  align-items: center;
  justify-content: center;
}
.form-card .dev-tip-label.data-v-cdfe2409 {
  font-size: 24rpx;
  color: #b2761a;
  margin-right: 16rpx;
}
.form-card .dev-tip-code.data-v-cdfe2409 {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff9900;
  letter-spacing: 6rpx;
}
.form-card .dev-tip-note.data-v-cdfe2409 {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #c08a3e;
  margin-top: 10rpx;
}
.footer.data-v-cdfe2409 {
  position: relative;
  z-index: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b6bcc4;
  margin-top: auto;
  padding-bottom: 50rpx;
}